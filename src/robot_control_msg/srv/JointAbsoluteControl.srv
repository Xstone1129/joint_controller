# 关节空间绝对位置控制服务
# 请求：关节空间绝对位置控制命令

# 左臂目标关节位置（7个关节）
float64 ljoint1
float64 ljoint2
float64 ljoint3
float64 ljoint4
float64 ljoint5
float64 ljoint6
float64 ljoint7

# 右臂目标关节位置（7个关节）
float64 rjoint1
float64 rjoint2
float64 rjoint3
float64 rjoint4
float64 rjoint5
float64 rjoint6
float64 rjoint7

# 速度和加速度参数
float64 vel
float64 acc

---
# 响应：操作结果
bool success
string message
