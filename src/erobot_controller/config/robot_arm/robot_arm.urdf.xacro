<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm">
    <xacro:arg name="initial_positions_file" default="$(find erobot_controller)/robot_arm/initial_positions.yaml" />
    <xacro:arg name="sim" default="0.0" />

    <xacro:include filename="$(find robot_arm_description)/urdf/right_left_arm.urdf" />
    <xacro:include filename="robot_arm.ros2_control.xacro" />

    <xacro:robot_arm_ros2_control name="armcontrol" initial_positions_file="$(arg initial_positions_file)" sim="$(arg sim)"/>
</robot>
